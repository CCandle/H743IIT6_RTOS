{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake --build --preset Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "cmake --build --preset Release",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean Debug",
            "type": "shell",
            "command": "ninja -C build/Debug clean"
        },
        {
            "label": "Clean Release",
            "type": "shell",
            "command": "ninja -C build/Release clean"
        },
        {
            "label": "Flash Debug (OpenOCD)",
            "type": "shell",
            "command": "openocd -f interface/stlink.cfg -f target/stm32h7x.cfg -c \"program build/Debug/${workspaceFolderBasename}.elf verify reset exit\"",
            "dependsOn": "Build Debug",
            "problemMatcher": []
        },
        {
            "label": "Flash Release (OpenOCD)",
            "type": "shell",
            "command": "openocd -f interface/stlink.cfg -f target/stm32h7x.cfg -c \"program build/Release/${workspaceFolderBasename}.elf verify reset exit\"",
            "dependsOn": "Build Release",
            "problemMatcher": []
        }
    ]
}